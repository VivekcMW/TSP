# Roadmap 25/26 additions only. Copy missing variables manually; never overwrite
# an existing .env or deployed value. This file contains no real credentials.
EMAIL_DIGEST_ENABLED=false
EMAIL_QUEUE_ENABLED=false
# Existing scheduler gates are also required for automatic digests.
BACKGROUND_JOBS_ENABLED=false
CRON_SCHEDULER=false
RESEND_API_KEY=
# Use a verified sending domain; receiving replies needs a mailbox or alias.
RESEND_FROM_EMAIL=hello@thesocialpundit.com
APP_URL=
DIAGNOSTICS_TOKEN=
REDIS_URL=
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Error monitoring (Sentry). Absent means monitoring is off, not a startup failure.
SENTRY_DSN=
VITE_SENTRY_DSN=
